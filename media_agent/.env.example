# ============ LLM（必填）============
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
LLM_TIMEOUT=120

# ============ 目录 ============
CACHE_DIR=./.cache
REPORT_DIR=./.cache/reports
VIDEO_OUTPUT_DIR=./.cache/videos
PLAN_DIR=./.cache/plans
IMAGE_DIR=./.cache/images

# ============ 联网检索（博查，账号定位的竞品分析用）============
# 获取地址：https://open.bochaai.com/  不填则自动降级为"模型推演"
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search

# ============ 数据采集规模（测试阶段保持 false：省 token、省库）============
# false=只留标题/链接/摘要前 160 字，不抓正文与配图；true=抓正文与 og:image
COLLECT_FULL_TEXT=false
# 单条正文最多保留多少字（COLLECT_FULL_TEXT=true 时生效）
MAX_TEXT_CHARS=400
# 单个数据源最多保留多少条
MAX_ITEMS_PER_SOURCE=30

# ============ 可选 PostgreSQL（不填就用 .cache/plans 下的 json 文件）============
# 需要先装驱动：uv add "psycopg[binary]"
# 本机实测可用的例子（PG 18.6 在 5433，5432 口令不同）：
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/langgraph
DATABASE_URL=

# ============ 媒体工具链（v3 视频剪辑需要）============
# ffmpeg 不在 PATH 时填绝对路径，例如 D:/tools/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=

# ============ 热点监控（v2）============
TRENDRADAR_API_URL=https://newsnow.busiyi.world/api/s

# ============ HeyGem 数字人（v2）============
HEYGEM_HOST=http://localhost:8383
HEYGEM_TTS_URL=http://localhost:18180
HEYGEM_ASR_URL=http://localhost:10095
HEYGEM_DATA_DIR=c:/duix_avatar_data/face2face

# ============ TTS 降级链（v2）============
TTS_ENABLED=true
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ============ 语音转写（内容复刻用）============
# http=贴链接给 AutoDL 转写服务（推荐，服务器自己下载+识别）；ws=旧的 WS 推流；local=本机 funasr
ASR_MODE=http
# 实例内的 FastAPI 转写服务（transcribe_server.py，默认 8000）；本机地址会自动走 SSH 隧道
ASR_HTTP_URL=http://127.0.0.1:8000
# 服务的 Bearer Token，留空则读 .cache/autodl.json 的 api_token（已 gitignore）
ASR_API_TOKEN=
# 旧 WebSocket 服务（仅在 ASR_MODE=ws 时使用）
FUNASR_WS_URL=ws://127.0.0.1:6006

# ============ AutoDL 实例（上传视频/音频 + 远程 FunASR）============
# 密码不要写这里，放 .cache/autodl.json（已 gitignore）或环境变量 AUTODL_PASSWORD
AUTODL_HOST=connect.nmb1.seetacloud.com
AUTODL_PORT=17653
AUTODL_USER=root
AUTODL_REMOTE_DIR=/root/autodl-tmp/asr_in
AUTODL_PASSWORD=

# ============ 外部素材路径（默认留空，页面上传）============
# 本地 douyin 采集项目目录（数据复盘用），例如 D:/project/douyin
DOUYIN_PROJECT_DIR=
# 视频剪辑默认 BGM，留空则页面里手选
DEFAULT_BGM_PATH=
